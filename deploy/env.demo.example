# Copy to server as /opt/afvc/.env (never commit the real file).
# Fill OPENAI_API_KEY on the server only.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
AFVC_USE_LLM=true
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=afvc

AFVC_DATA_PROFILE=demo
DATABASE_URL=postgresql://afvc_demo:afvc_demo@127.0.0.1:55433/afvc_demo
AFVC_DATA_BACKEND=sql
AFVC_AGENT_GRAPH=true

AFVC_SESSION_COOKIE=afvc_session
AFVC_SESSION_TTL_HOURS=168
# HTTP on public IP: false. After HTTPS/domain: true
AFVC_SESSION_SECURE=false
