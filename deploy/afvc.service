[Unit]
Description=AFVC FastAPI (uvicorn)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=afvc
Group=afvc
WorkingDirectory=/opt/afvc
EnvironmentFile=/opt/afvc/.env
ExecStart=/opt/afvc/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
