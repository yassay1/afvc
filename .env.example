# LLM 配置（OpenAI-compatible，使用智谱 GLM）
# 在智谱开放平台 https://bigmodel.cn 获取 API Key（形如 xxxx.yyyy），填到这里或用环境变量注入。
OPENAI_API_KEY=YOUR_ZHIPU_API_KEY
# 智谱 OpenAI 兼容 Base URL（国内端点，末尾保留斜杠）；国际账号用 https://api.z.ai/api/paas/v4/
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 最便宜/免费模型：glm-4-flash（也可用更新的免费模型 glm-4.5-flash / glm-4.7-flash）
OPENAI_MODEL=glm-4-flash
# 设为 true 后对话叙述改用真实 GLM；关闭时用模板兜底（不影响用例数据接口）
AFVC_USE_LLM=false
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=1

# LangSmith 配置
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=afvc

# Postgres（工单业务真相 + 可选 Agent checkpointer）
DATABASE_URL=postgresql://afvc:afvc@localhost:5432/afvc
# sql = 读 business.workorders；file = 紧急回退到 backend/data/raw 最新文件
AFVC_DATA_BACKEND=sql

# LangGraph 主路径。需同时 AFVC_USE_LLM=true 才生效；关闭则走 understand 兜底
AFVC_AGENT_GRAPH=true
