# LLM uses the OpenAI-compatible Chat Completions API. Put the key issued by your provider here.
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 智谱 GLM 示例：
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_MODEL=glm-4-flash
# 设为 true 后对话主路径走真实模型；关闭时用 understand 规则兜底（不影响用例数据接口）
AFVC_USE_LLM=false
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# LangSmith 配置。true 时 LangChain/LangGraph 自动上报 traces；thread_id = session_id
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=afvc

# 本地示例使用隔离的合成演示库。production 请显式改为正式库 URL。
AFVC_DATA_PROFILE=demo
DATABASE_URL=postgresql://afvc_demo:afvc_demo@127.0.0.1:55433/afvc_demo
# 切换 production 时设置正式库 URL；本地唯一 Compose 服务始终是隔离的 demo 数据库。
# demo 必须为 sql；production 下 file 可紧急回退到 backend/data/raw。
AFVC_DATA_BACKEND=sql

# LangGraph 主路径。需同时 AFVC_USE_LLM=true 才生效；关闭则走 understand 兜底
AFVC_AGENT_GRAPH=true

# 固定账号会话门禁（无自助注册；用 python -m backend.scripts.manage_user 建号）
AFVC_SESSION_COOKIE=afvc_session
AFVC_SESSION_TTL_HOURS=168
# 公网仅 HTTP（IP:80）时保持 false；上 HTTPS 后设为 true
AFVC_SESSION_SECURE=false
